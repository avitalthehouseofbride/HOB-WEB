---
import Base from '@/layouts/Base.astro';
import PropertyCard from '@/components/ui/PropertyCard.astro';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
---

<Base title={copy.brand} description={copy.intro}>
  <section class="px-6 pt-12 pb-16 md:px-10 md:pt-24 md:pb-24">
    <h1 class="max-w-3xl font-serif text-display leading-[1.05] font-light">{copy.tagline}</h1>
    <p class="mt-8 max-w-2xl text-lead">{copy.intro}</p>
  </section>
  <section class="grid gap-6 px-6 pb-24 md:grid-cols-2 md:px-10">
    <PropertyCard
      slug="netanya"
      name={copy.properties.netanya.name}
      line={copy.properties.netanya.line}
      href={localizedPath(locale, '/netanya')}
      cta={copy.cta.availability}
    />
    <PropertyCard
      slug="shoresh"
      name={copy.properties.shoresh.name}
      line={copy.properties.shoresh.line}
      href={localizedPath(locale, '/shoresh')}
      cta={copy.cta.availability}
    />
  </section>
</Base>

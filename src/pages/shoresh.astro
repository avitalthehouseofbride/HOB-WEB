---
import Base from '@/layouts/Base.astro';
import { getLocaleFromUrl, t } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
const property = copy.properties.shoresh;
---

<Base title={`${property.name} · ${copy.brand}`} description={property.line} property="shoresh">
  <section class="px-6 pt-12 pb-24 md:px-10 md:pt-24">
    <h1 class="font-serif text-display leading-[1.05] font-light" style="color: var(--accent)">
      {property.name}
    </h1>
    <p class="mt-6 max-w-2xl text-lead">{property.line}</p>
    <p class="mt-12 max-w-2xl text-stone">{copy.comingSoon}</p>
  </section>
</Base>

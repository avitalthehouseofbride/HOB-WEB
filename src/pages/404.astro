---
import Base from '@/layouts/Base.astro';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const copy = t(locale);
---

<Base title={`404 · ${copy.brand}`} description={copy.intro}>
  <section class="px-6 py-24 md:px-10">
    <h1 class="font-serif text-title">404</h1>
    <p class="mt-4"><a href={localizedPath(locale, '/')} class="underline">{copy.brand}</a></p>
  </section>
</Base>
